APP_NAME=AI Agent API
APP_VERSION=0.6.0
ENVIRONMENT=development

SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/ai_agent

LOG_LEVEL=INFO

# Multi-Model LLM Configuration
LLM_PROVIDER=gemini
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.0-flash

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Document & RAG Configuration
DOCUMENT_STORAGE_PATH=data/documents
FAISS_INDEX_PATH=data/indexes
MAX_DOCUMENT_SIZE_MB=10
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
# Hybrid Retrieval & Scoring Configuration
VECTOR_TOP_K=4
KEYWORD_TOP_K=4
RAG_TOP_K=4
VECTOR_RETRIEVAL_WEIGHT=0.6
KEYWORD_RETRIEVAL_WEIGHT=0.4

# Conversation Memory Configuration
MAX_CONVERSATION_MESSAGES=10
MAX_CONTEXT_TOKENS=4000

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# Security & Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3
RATE_LIMIT_AGENT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
MAX_REQUEST_SIZE_MB=15
MAX_MESSAGE_LENGTH=4000
MAX_TOOL_CALLS_PER_REQUEST=5
MAX_AGENT_GRAPH_ITERATIONS=10
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Multimodal Image Input & Compression Settings
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_DIMENSION=4096
IMAGE_COMPRESSION_THRESHOLD_MB=1.0
IMAGE_COMPRESSION_QUALITY=0.82
